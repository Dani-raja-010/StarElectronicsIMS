<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!-- Change "Data Source" to your SQL Server instance, or use File > Database settings inside the app. -->
    <add name="InventoryManagerDB"
         connectionString="Data Source=.\MSSQLSERVER2022;Initial Catalog=StarElectronicsDB;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
